# ===========================================
# NEON DATABASE CONFIGURATION
# ===========================================
# Get your connection string from the Neon Console:
# https://console.neon.tech/
#
# Format: postgresql://[user]:[password]@[host]/[database]?sslmode=require
DATABASE_URL=postgresql://username:password@ep-xxx-xxx-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# ===========================================
# DROP CONFIGURATION
# ===========================================
DROP_ENTRY_FEE_CAD=100
DROP_MIN_GLADIATORS=10
DROP_MAX_GLADIATORS=15
DROP_PAID_COUNT=7
DROP_PRIZE_PCT=0.6
DROP_HOUSE_PCT=0.4
DROP_CURRENCY=CAD

# Live Drop Settings
# LIVE_DROP_ACTIVE: "true" to enable voting, "false" to show upcoming state
LIVE_DROP_ID=drop_001
LIVE_DROP_ACTIVE=true
# LIVE_DROP_VOTING_OPENS_AT / LIVE_DROP_VOTING_CLOSES_AT: ISO 8601 timestamps (UTC)
# defining the window during which voting is open
LIVE_DROP_VOTING_OPENS_AT=2026-04-19T00:00:00Z
LIVE_DROP_VOTING_CLOSES_AT=2026-04-26T23:59:59Z
# LIVE_DROP_WINNER_HANDLE: X/Twitter handle of the winner.
# For ties, use comma-separated handles (e.g. "@winner1,@winner2")
LIVE_DROP_WINNER_HANDLE=@VictorVazquezC,@abejorrodigital
